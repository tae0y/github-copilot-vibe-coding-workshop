@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50" @onclick="HandleBackdropClick" style="@(IsOpen ? "display:flex" : "display:none")">
	<div class="bg-white dark:bg-gray-900 rounded-lg p-6 min-w-[300px] max-w-[90%] max-h-[90vh] overflow-y-auto shadow-xl" @onclick:stopPropagation="true">
		@ChildContent
	</div>
</div>

@code {
	[Parameter] public bool IsOpen { get; set; }
	[Parameter] public EventCallback OnClose { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }

	private DotNetObjectReference<Modal>? _dotNetRef;
	private IJSObjectReference? _jsModule;
	private IJSObjectReference? _jsHandler;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && IsOpen)
		{
			_dotNetRef = DotNetObjectReference.Create(this);
			_jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/modalHelper.js");
			_jsHandler = await _jsModule.InvokeAsync<IJSObjectReference>("registerEscKeyHandler", _dotNetRef);
		}
	}

	[JSInvokable]
	public async Task OnEscKey()
	{
		await OnClose.InvokeAsync();
	}

	private async Task HandleBackdropClick()
	{
		await OnClose.InvokeAsync();
	}

	public async ValueTask DisposeAsync()
	{
		if (_jsHandler is not null)
		{
			await _jsHandler.InvokeVoidAsync("dispose");
			await _jsHandler.DisposeAsync();
		}
		if (_jsModule is not null)
		{
			await _jsModule.DisposeAsync();
		}
		_dotNetRef?.Dispose();
	}
}
