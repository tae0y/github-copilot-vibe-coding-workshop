
@page "/"
@inject Contoso.BlazorApp.Services.PostApiService PostApi
@inject Contoso.BlazorApp.Services.AuthService AuthService

<PageTitle>Contoso Outdoor Social</PageTitle>

<div class="w-full max-w-2xl mx-auto">
	<h1 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">Contoso Outdoor Social</h1>
	@if (isLoading)
	{
		<div class="text-center py-10 text-gray-500">Loading posts...</div>
	}
	else if (!string.IsNullOrEmpty(error))
	{
		<div class="text-center py-10 text-red-500">@error</div>
	}
	else if (Posts.Count == 0)
	{
		<div class="text-center py-10 text-gray-400">No posts yet.</div>
	}
	else
	{
		<div class="flex flex-col gap-4">
			@foreach (var post in Posts)
			{
				<div class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 p-4">
					<div class="flex items-center mb-2">
						<div class="w-10 h-10 rounded-full bg-gray-200 dark:bg-gray-700 mr-2" />
						<div class="text-base font-bold text-gray-900 dark:text-white">@post.Username</div>
					</div>
					<div class="mb-2">
						<p class="text-base text-gray-900 dark:text-white leading-relaxed break-words">@post.Content</p>
					</div>
					<div class="flex gap-6 mt-2">
						<span class="flex items-center gap-1 text-gray-500">
							<span>&#10084;</span>
							@if (post.LikesCount > 0)
							{
								<span class="text-xs">@post.LikesCount</span>
							}
						</span>
						<span class="flex items-center gap-1 text-gray-500">
							<span>&#128172;</span>
							@if (post.CommentsCount > 0)
							{
								<span class="text-xs">@post.CommentsCount</span>
							}
						</span>
					</div>
				</div>
			}
		</div>
	}
</div>

@code {
	private List<Contoso.BlazorApp.Models.Post> Posts = new();
	private bool isLoading = true;
	private string error = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			isLoading = true;
			error = string.Empty;
			Posts = await PostApi.GetPostsAsync();
		}
		catch (Exception ex)
		{
			error = "An error occurred while loading posts.";
		}
		finally
		{
			isLoading = false;
		}
	}
}
